# Docker Configuration
# UID and GID should match your host user to avoid permission issues
UID=1000
GID=1000

# Nginx Configuration (Laravel)
NGINX_PORT=8000

# Vue.js / Vite Configuration
# FRONTEND_TARGET: "development" (dev server con HMR) | "production" (build + nginx)
FRONTEND_TARGET=development
VITE_PORT=3000
NODE_ENV=development

# PostgreSQL Configuration
POSTGRES_PORT=5432
POSTGRES_DB=tatelestai_db
POSTGRES_USER=tatelestai
POSTGRES_PASSWORD=secret

# Typesense Configuration
TYPESENSE_PORT=8108
TYPESENSE_API_KEY=xyz

# Xdebug Configuration (for development)
XDEBUG_ENABLED=true
XDEBUG_MODE=develop,coverage,debug,profile
XDEBUG_HOST=host.docker.internal
XDEBUG_IDE_KEY=DOCKER
XDEBUG_LOG=/dev/stdout
XDEBUG_LOG_LEVEL=0
